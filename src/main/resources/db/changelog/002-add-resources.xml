<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="2" author="Euan">
        <createTable tableName="resources">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="organizer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_resources_organizer" references="users(id)"/>
            </column>
            <column name="scheduled_time" type="TIMESTAMP"/>
            <column name="resource_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>INSERT INTO resources (id, title, description, organizer_id, scheduled_time, resource_type) SELECT id, title, description, teacher_id, scheduled_time, 'LESSON' FROM lessons</sql>

        <addColumn tableName="bookings">
            <column name="resource_id" type="BIGINT"/>
        </addColumn>

        <sql>UPDATE bookings SET resource_id = lesson_id</sql>

        <addNotNullConstraint tableName="bookings" columnName="resource_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="bookings" baseColumnNames="resource_id" constraintName="fk_bookings_resource" referencedTableName="resources" referencedColumnNames="id"/>
        <dropForeignKeyConstraint baseTableName="bookings" constraintName="fk_bookings_lesson"/>
        <dropColumn tableName="bookings" columnName="lesson_id"/>
    </changeSet>
</databaseChangeLog>
